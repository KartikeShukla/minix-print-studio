{
  "name": "minix-print-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop design and safe print studio for MiniX thermal printers.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @minix/desktop dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:node": "turbo run test --filter='./apps/*' --filter='./packages/*'",
    "test:python": "pytest daemon/tests mcp/tests",
    "format": "prettier --check .",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
